{
  "include": ["lib", "service.py", "script.py", "context.py", "tests"],
  "exclude": ["**/__pycache__", "**/.pytest_cache", ".venv"],
  "pythonVersion": "3.8",
  "pythonPlatform": "All",
  "typeCheckingMode": "basic",
