msgctxt "#32212"
msgid "Shows you are rewatching on Trakt match your rewatch progress in Kodi. Episodes watched since the rewatch started are marked watched, and the rest unwatched. Start a rewatch from a show's context menu or on Trakt."
msgstr "Seriály, ktoré opätovne pozeráte na Trakt, v Kodi zodpovedajú vášmu priebehu opätovného pozerania. Epizódy pozreté od začiatku opätovného pozerania sa označia ako pozreté a ostatné ako nepozreté. Opätovné pozeranie spustíte z kontextovej ponuky seriálu alebo na Trakt."

msgctxt "#32213"
msgid "Movie sync"
msgstr "Synchronizácia filmov"

msgctxt "#32214"
msgid "Episode sync"
msgstr "Synchronizácia epizód"

msgctxt "#32215"
msgid "Paused at %s"
