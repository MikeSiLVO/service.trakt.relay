msgstr "両方を残す"

msgctxt "#32220"
msgid "Start rewatch"
msgstr "再視聴を開始"

msgctxt "#32221"
msgid "Start a rewatch on Trakt? Your progress starts again, and every episode is marked unwatched in Kodi."
msgstr "Traktで再視聴を開始しますか？進捗は最初からになり、Kodiではすべてのエピソードが未視聴になります。"

msgctxt "#32222"
msgid "Rewatch started"
msgstr "再視聴を開始しました"

msgctxt "#32223"
