msgctxt "#32212"
msgid "Shows you are rewatching on Trakt match your rewatch progress in Kodi. Episodes watched since the rewatch started are marked watched, and the rest unwatched. Start a rewatch from a show's context menu or on Trakt."
msgstr "Seriály, které na Trakt sledujete znovu, v Kodi odpovídají vašemu průběhu opakovaného sledování. Epizody zhlédnuté od začátku opakovaného sledování se označí jako zhlédnuté a ostatní jako nezhlédnuté. Opakované sledování zahájíte z kontextové nabídky seriálu nebo na Trakt."

msgctxt "#32213"
msgid "Movie sync"
msgstr "Synchronizace filmů"

msgctxt "#32214"
msgid "Episode sync"
msgstr "Synchronizace epizod"

msgctxt "#32215"
msgid "Paused at %s"
msgstr "Pozastaveno na %s"

msgctxt "#32216"
