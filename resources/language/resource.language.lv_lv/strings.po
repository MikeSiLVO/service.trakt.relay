msgctxt "#32212"
msgid "Shows you are rewatching on Trakt match your rewatch progress in Kodi. Episodes watched since the rewatch started are marked watched, and the rest unwatched. Start a rewatch from a show's context menu or on Trakt."
msgstr "Seriāli, kurus atkārtoti skatāties Trakt, Kodi atbilst jūsu atkārtotās skatīšanās progresam. Sērijas, kas noskatītas kopš atkārtotās skatīšanās sākuma, tiek atzīmētas kā noskatītas, bet pārējās kā nenoskatītas. Sāciet atkārtotu skatīšanos no seriāla konteksta izvēlnes vai Trakt."

msgctxt "#32213"
msgid "Movie sync"
msgstr "Filmu sinhronizācija"

msgctxt "#32214"
msgid "Episode sync"
msgstr "Sēriju sinhronizācija"

msgctxt "#32215"
msgid "Paused at %s"
msgstr "Pauzēts pie %s"

msgctxt "#32216"
