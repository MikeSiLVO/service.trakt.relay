msgstr "Behåll båda"

msgctxt "#32220"
msgid "Start rewatch"
msgstr "Starta omtittning"

msgctxt "#32221"
msgid "Start a rewatch on Trakt? Your progress starts again, and every episode is marked unwatched in Kodi."
msgstr "Starta en omtittning på Trakt? Ditt förlopp börjar om och alla avsnitt markeras som osedda i Kodi."

msgctxt "#32222"
msgid "Rewatch started"
msgstr "Omtittning startad"

msgctxt "#32223"
