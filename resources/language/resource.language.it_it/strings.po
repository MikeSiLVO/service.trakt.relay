msgstr "Mantieni entrambi"

msgctxt "#32220"
msgid "Start rewatch"
msgstr "Avvia rewatch"

msgctxt "#32221"
msgid "Start a rewatch on Trakt? Your progress starts again, and every episode is marked unwatched in Kodi."
msgstr "Avviare un rewatch su Trakt? L'avanzamento riparte da zero e ogni episodio viene segnato come non visto in Kodi."

msgctxt "#32222"
msgid "Rewatch started"
msgstr "Rewatch avviato"

msgctxt "#32223"
