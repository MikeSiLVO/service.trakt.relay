msgctxt "#32212"
msgid "Shows you are rewatching on Trakt match your rewatch progress in Kodi. Episodes watched since the rewatch started are marked watched, and the rest unwatched. Start a rewatch from a show's context menu or on Trakt."
msgstr "Seriale, kere ôglōndŏsz zaś na Trakt, w Kodi sōm zgodne z twojim postympym powtōrnygo ôglōndaniŏ. Ôdcinki ôbejrzane, ôd kej zaczło sie powtōrne ôglōndanie, sōm ôznaczane za ôbejrzane, a reszta za niyôbejrzane. Powtōrne ôglōndanie zaczniesz z kōntekstowego menu serialu abo na Trakt."

msgctxt "#32213"
msgid "Movie sync"
msgstr "Synchronizacyjŏ filmōw"

msgctxt "#32214"
msgid "Episode sync"
msgstr "Synchronizacyjŏ ôdcinkōw"

msgctxt "#32215"
