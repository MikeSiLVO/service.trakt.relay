msgstr "De Trakt-add-on is ook ingeschakeld. Beide add-ons scrobbelen en synchroniseren met Trakt, dus alles gebeurt twee keer."

msgctxt "#32219"
msgid "Keep both"
msgstr "Beide behouden"

msgctxt "#32220"
