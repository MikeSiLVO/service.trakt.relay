msgstr "Herkijken starten"

msgctxt "#32221"
msgid "Start a rewatch on Trakt? Your progress starts again, and every episode is marked unwatched in Kodi."
msgstr "Herkijken starten op Trakt? Je voortgang begint opnieuw en alle afleveringen worden in Kodi als niet bekeken gemarkeerd."

msgctxt "#32222"
msgid "Rewatch started"
msgstr "Herkijken gestart"

msgctxt "#32223"
