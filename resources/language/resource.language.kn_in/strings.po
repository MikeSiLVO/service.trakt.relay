msgctxt "#32192"
msgid "Don't keep playback progress on Trakt"
msgstr "Trakt ನಲ್ಲಿ ಪ್ಲೇಬ್ಯಾಕ್ ಪ್ರಗತಿಯನ್ನು ಇರಿಸಬೇಡಿ"

msgctxt "#32193"
msgid "Respect Trakt rewatch progress"
msgstr "Trakt ಮರುವೀಕ್ಷಣೆ ಪ್ರಗತಿಯನ್ನು ಅನುಸರಿಸಿ"

msgctxt "#32196"
msgid "Sync ratings from Trakt to Kodi"
msgstr "Trakt ನಿಂದ Kodi ಗೆ ರೇಟಿಂಗ್‌ಗಳನ್ನು ಸಿಂಕ್ ಮಾಡಿ"

msgctxt "#32197"
msgid "Sync ratings from Kodi to Trakt"
msgstr "Kodi ಯಿಂದ Trakt ಗೆ ರೇಟಿಂಗ್‌ಗಳನ್ನು ಸಿಂಕ್ ಮಾಡಿ"

msgctxt "#32198"
msgid "Trakt"
msgstr "Trakt"

msgctxt "#32199"
msgid "Connect to Trakt"
msgstr "Trakt ಗೆ ಸಂಪರ್ಕಿಸಿ"

msgctxt "#32200"
msgid "Visit {0}[CR]or scan the QR code, then enter:"
msgstr "{0} ಗೆ ಭೇಟಿ ನೀಡಿ[CR]ಅಥವಾ QR ಕೋಡ್ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ, ನಂತರ ನಮೂದಿಸಿ:"

msgctxt "#32201"
msgid "This closes by itself once you approve."
msgstr "ನೀವು ಅನುಮೋದಿಸಿದ ನಂತರ ಇದು ತಾನಾಗಿಯೇ ಮುಚ್ಚುತ್ತದೆ."

msgctxt "#32202"
msgid "Not connected to Trakt. Connect from the add-on settings."
msgstr "Trakt ಗೆ ಸಂಪರ್ಕಗೊಂಡಿಲ್ಲ. ಆಡ್-ಆನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಸಂಪರ್ಕಿಸಿ."

msgctxt "#32206"
msgid "Kodi resume points"
msgstr "Kodi ಪುನರಾರಂಭ ಬಿಂದುಗಳು"

msgctxt "#32207"
msgid "Use the proxy below instead of Kodi's proxy setting."
msgstr "Kodi ಯ ಪ್ರಾಕ್ಸಿ ಸೆಟ್ಟಿಂಗ್ ಬದಲಿಗೆ ಕೆಳಗಿನ ಪ್ರಾಕ್ಸಿಯನ್ನು ಬಳಸಿ."

msgctxt "#32208"
msgid "Proxy server address, like http://proxy.lan."
msgstr "ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್ ವಿಳಾಸ, ಉದಾಹರಣೆಗೆ http://proxy.lan."

msgctxt "#32209"
msgid "Port of the proxy server."
msgstr "ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್‌ನ ಪೋರ್ಟ್."

msgctxt "#32210"
msgid "Optional user name needed to authenticate with the proxy."
msgstr "ಪ್ರಾಕ್ಸಿಯೊಂದಿಗೆ ದೃಢೀಕರಿಸಲು ಅಗತ್ಯವಿರುವ ಐಚ್ಛಿಕ ಬಳಕೆದಾರ ಹೆಸರು."

msgctxt "#32211"
msgid "Optional password needed to authenticate with the proxy."
msgstr "ಪ್ರಾಕ್ಸಿಯೊಂದಿಗೆ ದೃಢೀಕರಿಸಲು ಅಗತ್ಯವಿರುವ ಐಚ್ಛಿಕ ಪಾಸ್‌ವರ್ಡ್."

msgctxt "#32212"
msgid "Shows you are rewatching on Trakt match your rewatch progress in Kodi. Episodes watched since the rewatch started are marked watched, and the rest unwatched. Start a rewatch from a show's context menu or on Trakt."
msgstr "Trakt ನಲ್ಲಿ ನೀವು ಮರುವೀಕ್ಷಿಸುತ್ತಿರುವ ಕಾರ್ಯಕ್ರಮಗಳು Kodi ಯಲ್ಲಿ ನಿಮ್ಮ ಮರುವೀಕ್ಷಣೆ ಪ್ರಗತಿಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತವೆ. ಮರುವೀಕ್ಷಣೆ ಪ್ರಾರಂಭವಾದಾಗಿನಿಂದ ವೀಕ್ಷಿಸಿದ ಸಂಚಿಕೆಗಳನ್ನು ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಮತ್ತು ಉಳಿದವುಗಳನ್ನು ವೀಕ್ಷಿಸಲಾಗಿಲ್ಲ ಎಂದು ಗುರುತಿಸಲಾಗುತ್ತದೆ. ಕಾರ್ಯಕ್ರಮದ ಸಂದರ್ಭ ಮೆನುವಿನಿಂದ ಅಥವಾ Trakt ನಲ್ಲಿ ಮರುವೀಕ್ಷಣೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ."

msgctxt "#32213"
msgid "Movie sync"
msgstr "ಚಲನಚಿತ್ರ ಸಿಂಕ್"

msgctxt "#32214"
msgid "Episode sync"
msgstr "ಸಂಚಿಕೆ ಸಿಂಕ್"

msgctxt "#32215"
msgid "Paused at %s"
msgstr "%s ನಲ್ಲಿ ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ"

msgctxt "#32216"
msgid "Loading Trakt ratings"
msgstr "Trakt ರೇಟಿಂಗ್‌ಗಳನ್ನು ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

msgctxt "#32217"
msgid "Watching"
msgstr "ವೀಕ್ಷಿಸಲಾಗುತ್ತಿದೆ"

msgctxt "#32218"
msgid "The Trakt add-on is also enabled. Both add-ons scrobble and sync with Trakt, so everything is done twice."
msgstr "Trakt ಆಡ್-ಆನ್ ಕೂಡ ಸಕ್ರಿಯಗೊಂಡಿದೆ. ಎರಡೂ ಆಡ್-ಆನ್‌ಗಳು Trakt ನೊಂದಿಗೆ ಸ್ಕ್ರಾಬಲ್ ಮತ್ತು ಸಿಂಕ್ ಮಾಡುತ್ತವೆ, ಆದ್ದರಿಂದ ಎಲ್ಲವೂ ಎರಡು ಬಾರಿ ನಡೆಯುತ್ತದೆ."

msgctxt "#32219"
msgid "Keep both"
msgstr "ಎರಡನ್ನೂ ಇರಿಸಿ"

msgctxt "#32220"
msgid "Start rewatch"
msgstr "ಮರುವೀಕ್ಷಣೆ ಪ್ರಾರಂಭಿಸಿ"

msgctxt "#32221"
msgid "Start a rewatch on Trakt? Your progress starts again, and every episode is marked unwatched in Kodi."
msgstr "Trakt ನಲ್ಲಿ ಮರುವೀಕ್ಷಣೆ ಪ್ರಾರಂಭಿಸಬೇಕೆ? ನಿಮ್ಮ ಪ್ರಗತಿ ಮತ್ತೆ ಮೊದಲಿನಿಂದ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಮತ್ತು Kodi ಯಲ್ಲಿ ಪ್ರತಿ ಸಂಚಿಕೆಯನ್ನು ವೀಕ್ಷಿಸಲಾಗಿಲ್ಲ ಎಂದು ಗುರುತಿಸಲಾಗುತ್ತದೆ."

msgctxt "#32222"
msgid "Rewatch started"
msgstr "ಮರುವೀಕ್ಷಣೆ ಪ್ರಾರಂಭವಾಯಿತು"

msgctxt "#32223"
msgid "Couldn't start rewatch"
msgstr "ಮರುವೀಕ್ಷಣೆ ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"

msgctxt "#32224"
msgid "Use the OG Trakt theme"
msgstr "OG Trakt ಥೀಮ್ ಬಳಸಿ"

msgctxt "#32225"
msgid "Shows Trakt's red logo, hearts and highlights, as on og.trakt.tv."
msgstr "og.trakt.tv ನಲ್ಲಿರುವಂತೆ Trakt ನ ಕೆಂಪು ಲೋಗೋ, ಹೃದಯಗಳು ಮತ್ತು ಹೈಲೈಟ್‌ಗಳನ್ನು ತೋರಿಸುತ್ತದೆ."
