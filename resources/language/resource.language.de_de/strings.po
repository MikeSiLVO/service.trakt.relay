msgstr "Beide behalten"

msgctxt "#32220"
msgid "Start rewatch"
msgstr "Erneutes Ansehen starten"

msgctxt "#32221"
msgid "Start a rewatch on Trakt? Your progress starts again, and every episode is marked unwatched in Kodi."
msgstr "Erneutes Ansehen auf Trakt starten? Dein Fortschritt beginnt von vorn, und jede Episode wird in Kodi als ungesehen markiert."

msgctxt "#32222"
msgid "Rewatch started"
msgstr "Erneutes Ansehen gestartet"

msgctxt "#32223"
